@model List<GiapDepTrai.Models.TblTable>

<main class="flex-grow-1 p-4 bg-light" style="margin-top: 100px;">
    <div class="container-fluid">
        <h1 class="text-gradient mb-5 text-center animate__animated animate__fadeInDown">Chọn bàn ăn</h1>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success animate__animated animate__fadeIn">
                @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ReceiptFilePath"] != null)
        {
            <div class="alert alert-success animate__animated animate__fadeIn">
                @TempData["ReceiptFilePath"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger animate__animated animate__fadeIn">
                @TempData["ErrorMessage"]
            </div>
        }
        <div class="row justify-content-center mb-4">
            <div class="col-md-8">
                @if (ViewBag.AlertMessage != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-lg animate__animated animate__bounceIn mt-4" role="alert">
                        @ViewBag.AlertMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
            </div>
        </div>

        <div class="jct">
            <div class="box-list">
                @foreach (var item in Model)
                {
                    var customerId = Context.Session.GetInt32("CustomerID");
                    <div class="box-item">
                        <div class="container1">
                            @if (item.Status != null)
                            {
                                <div class="card" style="@GetTableStyle(item.Status)">
                                    <div class="pic">
                                        <p style="font-size: 24px;" class="status-text">@item.TableName</p>
                                        <p style="font-size: 24px;" class="status-text">@item.Status</p>
                                    </div>
                                    @if (item.Status == "Bảo trì")
                                    {
                                        <a href="javascript:void(0);" class="disabled" onclick=" return showMaintenanceAlert()"></a>
                                    }
                                    else if (item.Status == "Đã được đặt")
                                    {
                                        <a href="~/Admin/Order/EmployeeOrder?TableID=@item.TableId&amp;EmployeeID=@ViewBag.Order_EmployeeID_ChooseTB&amp;BranchID=@ViewBag.Order_BranchID_ChooseTB" onclick="return confirmBookedTable()"></a>
                                    }
                                    else
                                    {
                                        <a href="~/Admin/Order/EmployeeOrder?TableID=@item.TableId&amp;EmployeeID=@ViewBag.Order_EmployeeID_ChooseTB&amp;BranchID=@ViewBag.Order_BranchID_ChooseTB"></a>
                                    }
                                </div>
                                <div style="width: 100%; display: flex; flex-wrap: wrap; justify-content: space-between;">
                                <p class="status-text" style="width: 30%; font-size: 16px;"> chỗ ngồi: @item.TableType.Seats</p>
                                @if (item.Status == "Đã được đặt")
                                {
                                    <button class="btn btn-info mt-2" style="width: max-content; height: fit-content; border-radius: 10px; font-size: 14px;" onclick="showTableInfo(@item.TableId)">Xem thông tin</button>
                                }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="modal fade" id="tableInfoModal" tabindex="-1" aria-labelledby="tableInfoLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="tableInfoLabel">Thông tin bàn</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body" id="tableInfoContent">
                    
                </div>
                </div>
            </div>
            </div>
    </div>
</main>

@functions {
    public string GetTableStyle(string status)
    {
        return status switch
        {
            "Trỗng" => "background: linear-gradient(60deg,rgb(24, 24, 68) 0%,rgba(8, 70, 156, 0.78) 100%);",
            "Bảo trì" => "background: linear-gradient(60deg,rgb(71, 27, 27) 0%,rgba(151, 13, 6, 0.83) 100%);",
            "Đã đặt bàn" => "background: linear-gradient(60deg,rgba(211, 218, 209, 0.83) 0%, rgb(64, 65, 64) 100%);",
            _ => "background: linear-gradient(60deg, #151516 0%, #1d2229 100%);"
        };
    }
}

@section Scripts {
    <script>
        function showMaintenanceAlert() {
            return alert("Bàn đang bảo trì, không thể chọn.");
        }

        function confirmBookedTable() {
            return confirm("Bàn đã được đặt, vui lòng cân nhắc. Bạn có muốn tiếp tục?");
        }
    </script>
    <script>
        function showTableInfo(tableId) {
            $.ajax({
                url: '/Reservation/GetTableInfo',
                type: 'GET',
                data: { id: tableId },
                success: function (data) {
                    $('#tableInfoContent').html(data);
                    $('#tableInfoModal').modal('show');
                },
                error: function () {
                    alert('Lỗi khi tải thông tin bàn.');
                }
            });
        }

        $(document).ready(function () {
            var successMessage = '@TempData["SuccessMessage"]';
            var errorMessage = '@TempData["ErrorMessage"]';
            if (errorMessage){
                alert(errorMessage)
            }
            if (successMessage) {
                alert(successMessage);
            }
        });

    </script>

}

<style>
    .jct {
        display: flex;
        flex-direction: column;
        align-items: center;
        min-height: 100vh;
        width: 100%;
        background-color: transparent;
    }

    .box-list {
        width: 100%;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-around;
        padding: 20px;
    }

    .box-item {
        width: calc(33.33% - 10px);
        margin-bottom: 20px;
        border-radius: 10px;
        padding: 15px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .container1 {
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
    }

    .container1 .card {
        position: relative;
        width: 100%;
        height: 170px;
        padding: 15px;
        overflow: hidden;
        margin-bottom: 15px;
        border-radius: 20px;
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.3);
    }

    .container1 .card a.disabled {
        cursor: not-allowed;
        pointer-events: auto;
    }

    .container1 .card:hover a.disabled {
        transform: none;
        opacity: 1;
    }

    .container1 .card span {
        z-index: 99;
        position: absolute;
        top: 25px;
        right: 35px;
        font-size: 10px;
        letter-spacing: 1px;
        writing-mode: vertical-lr;
        transition: 0.2s ease;
        text-shadow: 2px 2px 5px rgb(7, 7, 7);
        opacity: 0.7;
    }

    .container1 .card a {
        position: absolute;
        right: 30px;
        bottom: 40px;
        width: 30px;
        height: 30px;
        border: none;
        border-radius: 50%;
        cursor: pointer;
        outline: none;
        z-index: 101;
        transition: transform 0.3s ease, opacity 0.3s ease;
        background-color: transparent;
    }

    .container1 .card:hover a {
        transform: scale(16.5);
        opacity: 0;
    }

    .container1 .card:hover h2 {
        bottom: 80px;
        right: 50px;
    }

    .container1 .card:hover span {
        opacity: 0;
        right: 60px;
    }

    .container1 .card:hover .pic {
        filter: grayscale(0);
        height: 100%;
    }

    .container1 .card .pic {
        z-index: 98;
        width: 100%;
        height: 100%;
        background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.2)), url('/assets/images/bbb.jpg');
        background-size: cover;
        background-position: center;
        border-radius: 12px;
        filter: grayscale(100%);
        transition: 0.3s ease;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .container1 .card .pic .status-text {
        color: white;
        font-size: 32px;
        font-weight: bold;
        text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.8);
        text-align: center;
        margin: 0;
        padding: 10px;
    }
    .status-text{
        font-size: 16px;
        font-weight: 600;
    }
</style>