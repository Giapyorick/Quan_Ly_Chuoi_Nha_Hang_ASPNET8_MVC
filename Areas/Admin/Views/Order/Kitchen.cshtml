@model GiapDepTrai.Models.KitchenModel
@{
    ViewData["Title"] = "Bếp - Thông báo đơn hàng";
}
<main>
<main class="container mt-4">
    <h2 class="text-center mb-4">Bếp - Thông báo đơn hàng mới</h2>
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0 text-white">Thông báo đơn hàng mới</h5>
        </div>
        <div class="card-body" style="height: 200px; overflow-y: auto;">
            <div id="notifications" class="p-2"></div>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0 text-white">Đơn hàng gần đây</h5>
        </div>
        <div class="card-body">
            @if (Model?.RecentOrders != null && Model.RecentOrders.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>ID đơn hàng</th>
                                <th>Bàn</th>
                                <th>Thời gian</th>
                                <th>Chi tiết món</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.RecentOrders)
                            {
                                <tr>
                                    <td>@order.OrderId</td>
                                    <td>@order.TableId</td>
                                    <td>@order.OrderTime?.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                    <td>
                                        <ul class="list-unstyled mb-0">
                                            @foreach (var detail in order.TblEmployeeOrderDetails)
                                            {
                                                <li>
                                                    <strong>@detail.MenuItem.ItemName</strong> 
                                                    (Số lượng: @detail.Quantity) 
                                                    @if (!string.IsNullOrEmpty(detail.Notes))
                                                    {
                                                        <span class="text-muted">(Ghi chú: @detail.Notes)</span>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted text-center">Chưa có đơn hàng nào.</p>
            }
            <nav class="shadow-lg p-3 bg-white rounded-3 mt-4 animate__animated animate__fadeInUp">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= ViewBag.TotalPagesKitchen; i++)
                {
                    <li class="page-item @(i == ViewBag.CurrentPageKitchen ? "active" : "") shadow-sm">
                        <a class="page-link" href="@Url.Action("Kitchen", new { page = i })">@i</a>
                    </li>
                }
            </ul>
        </nav>
        </div>
    </div>

    <audio id="notificationSound" src="/assets/sounds/notification.mp3" preload="auto"></audio>
</main>
</main>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>
    <script>
        function enableSound() {
            const sound = document.getElementById("notificationSound");
            sound.play().then(() => {
                sound.pause();
                sound.currentTime = 0;
                alert("Âm thanh thông báo đã được kích hoạt!");
            }).catch(error => {
                console.error("Lỗi khi kích hoạt âm thanh: ", error);
            });
        }

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/kitchenHub")
            .build();

        connection.on("ReceiveOrderNotification", function (message) {
            const notificationDiv = document.getElementById("notifications");
            const newNotification = document.createElement("p");
            newNotification.className = "alert alert-info mb-2 p-2";
            newNotification.textContent = message;
            notificationDiv.insertBefore(newNotification, notificationDiv.firstChild); 

            const sound = document.getElementById("notificationSound");
            sound.play().catch(function (error) {
                console.error("Lỗi khi phát âm thanh: ", error);
            });
        });

        connection.start().then(function () {
            connection.invoke("JoinKitchenGroup").catch(function (err) {
                return console.error(err.toString());
            });
        }).catch(function (err) {
            return console.error(err.toString());
        });
    </script>
}