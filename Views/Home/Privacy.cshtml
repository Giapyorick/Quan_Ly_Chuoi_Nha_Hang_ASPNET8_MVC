<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Masonry Grid</title>
    <style>
        body {
            background-color: #111;
            color: white;
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .masonry-container {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            grid-auto-rows: 10px;
            gap: 10px;
            width: 80%;
            max-width: 1000px;
        }

        .masonry-item {
            border-radius: 10px;
            overflow: hidden;
            background: #222;
        }

            .masonry-item img {
                width: 100%;
                display: block;
            }
    </style>
</head>
<body>

    <div class="masonry-container">
        <div class="masonry-item"><img src="./assets/images/Customer/Customer_0f29107b-db9f-4305-8bc0-65b304ec3ce4.jpg" alt="Ảnh 1"></div>
        <div class="masonry-item"><img src="./assets/images/Customer/Customer_0f29107b-db9f-4305-8bc0-65b304ec3ce4.jpg" alt="Ảnh 2"></div>
        <div class="masonry-item"><img src="./assets/images/Customer/Customer_0f29107b-db9f-4305-8bc0-65b304ec3ce4.jpg" alt="Ảnh 3"></div>
        <div class="masonry-item"><img src="./assets/images/Customer/Customer_0f29107b-db9f-4305-8bc0-65b304ec3ce4.jpg" alt="Ảnh 4"></div>
        <div class="masonry-item"><img src="./assets/images/Customer/Customer_0f29107b-db9f-4305-8bc0-65b304ec3ce4.jpg" alt="Ảnh 5"></div>
        <div class="masonry-item"><img src="./assets/images/Customer/Customer_0f29107b-db9f-4305-8bc0-65b304ec3ce4.jpg" alt="Ảnh 6"></div>
        <div class="masonry-item"><img src="./assets/images/Customer/Customer_0f29107b-db9f-4305-8bc0-65b304ec3ce4.jpg" alt="Ảnh 7"></div>
        <div class="masonry-item"><img src="./assets/images/Customer/Customer_0f29107b-db9f-4305-8bc0-65b304ec3ce4.jpg" alt="Ảnh 8"></div>
    </div>

</body>
</html>
