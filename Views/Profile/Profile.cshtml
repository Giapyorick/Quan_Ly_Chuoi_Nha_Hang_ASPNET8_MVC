@model GiapDepTrai.Models.TblCustomer

<div style="width: 100%; display: flex; flex-wrap: wrap; justify-content: center;" >
<div class="profile-card">
    @if (Model != null)
    {
        <div class="profile-image-container">
            <img src="~/@Model.Img" alt="@(Model.FullName ?? "Profile")" class="profile-image" />
            <div class="profile-image-overlay"></div>
            <h2 class="profile-title">@Model.FullName</h2>
        </div>
    }
    else
    {
        <div class="error-message">
            <p>Profile not found.</p>
        </div>
    }
</div>
<div class="profile-card">
	<div class="profile-content">
		<div class="profile-info"><span style="font-size: 26px; font-weight: 700;"> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;Thông tin cá nhân</span></div>
		<div style="height: 40px;"></div>
		<div class="profile-info"><span>Giới tính:</span> @Model.Gender</div>
		<div class="profile-info"><span>SĐT:</span> @Model.Phone</div>
		<div class="profile-info"><span>Địa chỉ:</span> @Model.Address</div>
		<div class="profile-info"><span>Email:</span> @(Model.Email ?? "Not provided")</div>
		<div class="profile-info"><span>Ngày sinh:</span> @(Model.BirthofDate?.ToString("dd-MM-yyyy") ?? "Not provided")</div>
		<div class="profile-info"><span>Căn cước:</span> @(Model.IdentityCard ?? "Not provided")</div>
		<div class="profile-info"><span>Ngày đăng ký:</span> @(Model.CreatedAt?.ToString("dd-MM-yyyy") ?? "Not provided")</div>
        <div class="profile-info"><span>Xem lịch sử:</span></div>
		<div class="edit-button">
            <a asp-controller="Reservation" asp-action="List">Đặt bàn</a>
            <a asp-controller="ReservationPayment" asp-action="History">Thanh toán</a>
		</div>
	</div>
</div>
</div>
<style>
    .history-button {
    padding: 10px;
    background-color: #007bff;
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 16px;
    transition: background-color 0.3s;
    }

    .history-button:hover {
    background-color: #0056b3;
    }
    .profile-card {
        margin-bottom: 80px;
		margin-top: 135px;
		margin-right:20px ;
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
        max-width: 360px;
        width: 100%;
        overflow: hidden;
        position: relative;
        transform: translateY(0);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .profile-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3);
    }
    .profile-image-container {
        position: relative;
        height: 500px;
        overflow: hidden;
    }
    .profile-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .profile-image-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 50%;
        background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
    }
    .profile-title {
        position: absolute;
        bottom: 20px;
        left: 20px;
        color: #fff;
        font-size: 28px;
        font-weight: bold;
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.5);
    }
    .profile-content {
        padding: 20px;
    }
    .profile-info {
        margin-bottom: 12px;
        font-size: 16px;
        color: #333;
    }
    .profile-info span {
        font-weight: 600;
        color: #4099e2;
    }
    .edit-button {
        text-align: center;
        margin-top: 20px;
    }
    .edit-button a {
        display: inline-block;
        background: #4099e2;
        color: #fff;
        padding: 10px 20px;
        border-radius: 25px;
        text-decoration: none;
        font-weight: 500;
        transition: background 0.3s ease, transform 0.3s ease;
    }
    .edit-button a:hover {
        background: #0438a7;
        transform: scale(1.05);
    }
    .error-message {
        text-align: center;
        color: #0438a7;
        font-size: 18px;
        padding: 20px;
    }
</style>
