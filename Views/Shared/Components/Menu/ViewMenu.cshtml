@model IList<TblMenu>


        @foreach (var menu in Model.Where(m => m.Levels == 1).OrderBy(m => m.MenuOrder))
        {
            var pID = menu.MenuId;
            var sMenu = Model.Where(s => s.ParentId == pID).OrderBy(s => s.MenuOrder).ToList();

            if(sMenu.Count == 0)
            {
                <li><a asp-controller="@menu.ControllerName" asp-action="@menu.ActionName" >@menu.MenuName</a></li>
            }
        }
        @{

        }
