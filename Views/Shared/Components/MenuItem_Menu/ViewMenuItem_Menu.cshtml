@model List<TblMenuItem>
<section class="section-grey">
        
        <!--begin container-->
        <div class="container">

            <!--begin row-->
            <div class="row">
            
                <!--begin col-md-6-->
                <div class="col-md-6">
                
                    <h2 class="menu-section-title">Đồ ăn</h2>
                    @foreach (var item in Model.Where(i => i.IsAvailable == true && i.CategoryId == 1).Take(4))
        			{
                    <!--begin menu-wrapper-->
                    <div class="menu-wrapper">
                        
                        <!--begin menu-image-->
                        <div class="menu-image">
                        
                        	<img src="@item.ImageUrl" class="width-100" alt="food">
                            <a href="http://localhost:5214/MenuItem/Details?id=@item.MenuItemId">
                                
                        </div>
                        <!--end menu-image-->
                         
                        <!--begin menu-description-->
                        <div class="menu-description">
                           
                            <!--begin menu-list-->
                            <div class="menu-list">
                            
                                <h5>@item.ItemName</h5>
                                
                                <p class="price">@item.Price</p>
                                
                                <span class="menu-dot-line"></span>
                                
                            </div>
                            <!--end menu-list-->
                            
                            <p class="menu-ingredients">@item.Descriptions</p>
                                
                        </div>
						
                        <!--end menu-description-->
                                
                    </div>
                    <!--end menu-wrapper-->
                    }
                    
                </div>
                <!--end col-md-6-->
            
                <!--begin col-md-6-->
                <div class="col-md-6">
                
                    <h2 class="menu-section-title">Đồ uống</h2>
