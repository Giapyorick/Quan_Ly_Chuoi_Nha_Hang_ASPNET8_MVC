@model IList<TblNavigationHome>
@{
    var item = Model.FirstOrDefault(n => n.IsActive == true);

    <div class="col-md-4">

        <!--begin blog-item -->
        <div class="blog-item">

            <!--begin popup image -->
            <div class="popup-wrapper">
                <div class="popup-gallery">
                    <div class="image-wrapper">
                        <img src="@item.PicNav1" class="width-100" alt="pic">
                        <div class="black-overlay"></div>
                        <a href="#about" class="scrool">
                            <span class="eye-wrapper"></span>
                            <span class="text">@item.Nav1</span>
                        </a>
                    </div>
                </div>

            </div>
            <!--begin popup image -->

        </div>
        <!--end blog-item -->

    </div>
    <div class="col-md-4">

        <!--begin blog-item -->
        <div class="blog-item">

            <!--begin popup image -->
            <div class="popup-wrapper">
                <div class="popup-gallery">
                    <div class="image-wrapper">
                        <img src="@item.PicNav2" class="width-100" alt="pic">
                        <div class="black-overlay"></div>
                        <a href="#menu" class="scrool">
                            <span class="eye-wrapper"></span>
                            <span class="text">@item.Nav2</span>
                        </a>
                    </div>
                </div>

            </div>
            <!--begin popup image -->

        </div>
        <!--end blog-item -->

    </div>
    <div class="col-md-4">

        <!--begin blog-item -->
        <div class="blog-item">

            <!--begin popup image -->
            <div class="popup-wrapper">
                <div class="popup-gallery">
                    <div class="image-wrapper">
                        <img src="@item.PicNav3" class="width-100" alt="pic">
                        <div class="black-overlay"></div>
                        <a href="#event" class="scrool">
                            <span class="eye-wrapper"></span>
                            <span class="text">@item.Nav3</span>
                        </a>
                    </div>
                </div>

            </div>
            <!--begin popup image -->

        </div>
        <!--end blog-item -->

    </div>
}
<style>
    .image-wrapper {
    position: relative;
    display: inline-block;
    overflow: hidden;
}

.black-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.3);
    z-index: 1;
}

.image-wrapper img {
    display: block;
    width: 100%;
    height: auto;
}

.image-wrapper a {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    color: white; /* cho chữ nổi lên */
    display: flex;
    justify-content: center;
    align-items: center;
    text-decoration: none;
}

</style>
